# ===== fechou o brick — deploy VPS (docker-compose.yml) =====
# cp .env.example .env  e preencha os valores reais.

# Postgres já instalado na VPS. Se roda direto no host (fora de container),
# use host.docker.internal como host (o compose mapeia via extra_hosts).
# Crie antes o database:  CREATE DATABASE fechou_brick;
DATABASE_URL=postgres://USUARIO:SENHA@host.docker.internal:5432/fechou_brick?sslmode=disable

# Segredo do JWT do admin — gere um valor forte, ex.: openssl rand -base64 32
JWT_SECRET=TROQUE-ME

# Usuário único do admin. A senha inicial é usada só na primeira subida
# (a API grava o hash bcrypt no banco se a tabela estiver vazia).
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=TROQUE-ME

# Porta pública do frontend na VPS (o nginx do FE proxia /api para a API interna)
FE_PORT=8084

# Teto de upload por foto (MB)
MAX_UPLOAD_MB=10
